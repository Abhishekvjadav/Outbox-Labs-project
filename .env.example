# ==============================================================================
# REACHFLOW SYSTEM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=reachflow-super-secure-jwt-secret-key-replace-in-production-min32

# Database Connection (PostgreSQL)
# For local Docker: postgresql://postgres:postgrespassword@localhost:5432/reachflow?schema=public
# For free cloud Postgres (Neon.tech / Supabase): postgresql://user:pass@ep-xyz.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/reachflow?schema=public

# Redis Connection (BullMQ & Atomic Rate Limiter)
# For local Docker: localhost:6379
# For Upstash / Redis Cloud: rediss://default:password@xyz.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Worker Concurrency & Throttling
WORKER_CONCURRENCY=5
DEFAULT_MIN_EMAIL_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=100

# Elasticsearch Configuration
# Set to true to enable ES search indexing; falls back gracefully to DB search if disabled/unavailable
ENABLE_ELASTICSEARCH=true
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth 2.0 Credentials (https://api.slack.com/apps)
# Scopes: chat:write, chat:write.public, channels:read
# Authorized redirect URI: http://localhost:5000/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/slack/callback

# Optional: Default Ethereal credentials (if omitted, ReachFlow automatically provisions one via nodemailer.createTestAccount())
DEFAULT_ETHEREAL_USER=
DEFAULT_ETHEREAL_PASS=
