    "test:idempotency": "jest tests/idempotency.test.ts --runInBand",
    "test:restart": "jest tests/restart.test.ts --runInBand",
    "test:retry": "jest tests/retry.test.ts --runInBand",
    "test:throttle": "jest tests/throttle.test.ts --runInBand"
  },
  "dependencies": {
    "@bull-board/api": "^5.21.3",
    "@bull-board/express": "^5.21.3",
    "@elastic/elasticsearch": "^8.14.0",
    "@prisma/client": "^5.19.1",
    "@reachflow/shared": "file:../packages/shared",
    "@slack/web-api": "^7.3.3",
    "bullmq": "^5.12.9",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.14.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
